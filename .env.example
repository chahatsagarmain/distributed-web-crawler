# MongoDB Connection (default credentials from compose.yaml)
# Use 'mongodb' instead of 'localhost' if running inside the docker-compose network
MONGO_URI=mongodb://admin:password@localhost:27017

# Redis Connection (default credentials from compose.yaml)
# Use 'redis:6379' instead of 'localhost:6379' if running inside the docker-compose network
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# RabbitMQ Connection (default credentials from compose.yaml)
# Use 'rabbitmq' instead of 'localhost' if running inside the docker-compose network
RABBITMQ_URI=amqp://guest:guest@localhost:5672/
